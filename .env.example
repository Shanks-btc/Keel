# Keel environment variables — copy to .env and fill in values.
# Never commit .env to source control.

# ── Perception (CMC) — REQUIRED to run the agent ────────────────────────────
# Free Basic tier is sufficient. Header: X-CMC_PRO_API_KEY
CMC_API_KEY=

# ── TWAK authentication — REQUIRED for quote and execution ──────────────────
# Set before running: twak init   (saves to ~/.twak/credentials.json)
TWAK_ACCESS_ID=
TWAK_HMAC_SECRET=

# ── BSC RPC (optional override) ──────────────────────────────────────────────
# Defaults to the public Binance dataseed. Set to a private RPC for reliability.
BSC_RPC=https://bsc-dataseed.binance.org

# ── Proof anchoring ──────────────────────────────────────────────────────────
# Optional: a known USDT contract address on BSC to verify RPC liveness.
PROOF_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# ── BNB Agent SDK (identity) — OPTIONAL ──────────────────────────────────────
# Only needed when running identity registration (gas-free via paymaster).
BNB_NETWORK=bsc-mainnet
BNB_WALLET_PASSWORD=
BNB_PRIVATE_KEY=

# ── x402 (fund-gated — paid calls only) ─────────────────────────────────────
# Throwaway wallet with a small USDC balance on Base. Max payment ~0.01 USDC.
X402_WALLET_PRIVATE_KEY=

# ── Execution guard (real swap gate) ─────────────────────────────────────────
# Must be set to "yes" before running --swap in verify.ts. Prevents accidents.
I_UNDERSTAND_REAL_FUNDS=
